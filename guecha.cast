[0.067, "o", "\u001b[33m  ⚠ guecha warned:\u001b[0m\r\n"]
[0.022, "o", "    - [ancho-cero] 1 invisible character(s) (embedded in words or in a run), first near line 1\r\n"]
[0.004, "o", "\r\n"]
[1.303, "o", "\u001b[1m→ a Trojan-Source bidi override\u001b[0m\r\n"]
