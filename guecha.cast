[0.000, "o", "\u001b[1mguecha — prompt-injection defense for AI coding agents\u001b[0m\r\n"]
[0.001, "o", "\u001b[2mAn agent reads untrusted text and then acts. guecha watches what it reads.\u001b[0m\r\n\r\n"]
[1.604, "o", "\u001b[1m→ a normal README (emoji, accents — legitimate)\u001b[0m\r\n"]
[0.090, "o", "\u001b[32m  ✓ clean — passed silently\u001b[0m\r\n\r\n"]
