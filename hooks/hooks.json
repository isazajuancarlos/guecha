{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|WebFetch|WebSearch|Bash|Grep|Task|mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/guecha-obfuscation",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/guecha-persistence",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
